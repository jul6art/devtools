<?xml version="1.0" encoding="UTF-8"?>
<!--
    The categories of feedback DevTools ships (resources/feedback/categories.xml, ADR-0025).

    ⚠️ Public contract: an incompatible change is a new schema-version and a major release.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://github.com/jul6art/devtools/schema/feedback-categories/1"
           targetNamespace="https://github.com/jul6art/devtools/schema/feedback-categories/1"
           elementFormDefault="qualified">

    <xs:element name="categories">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="category" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attribute name="name" type="t:name" use="required"/>
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="schema-version" type="xs:positiveInteger" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="name">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z][a-z0-9]*(-[a-z0-9]+)*"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
