<?xml version="1.0" encoding="UTF-8"?>
<!--
    The secrets ai:run refuses to send (ADR-0035): resources/secrets/patterns.xml.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://github.com/jul6art/devtools/schema/secret-patterns/1"
           targetNamespace="https://github.com/jul6art/devtools/schema/secret-patterns/1"
           elementFormDefault="qualified">

    <xs:element name="secret-patterns">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="pattern" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="t:nonEmpty">
                                <xs:attribute name="name" type="t:nonEmpty" use="required"/>
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="schema-version" type="xs:positiveInteger" use="required" fixed="1"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="nonEmpty">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
