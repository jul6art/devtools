{
    // Mutation testing of the two directories every later guarantee rests on (ADR-0010): a false
    // "unchanged" in Freshness, or a tracking file that does not read back, breaks impact and the gate.
    // It needs a coverage driver (pcov or Xdebug); the CI's "Mutation" job provides pcov.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src/Inspection/Freshness",
            "src/Tracking"
        ]
    },
    "phpUnit": {
        "configDir": "."
    },
    "testFrameworkOptions": "--exclude-group=end-to-end --exclude-group=performance",
    "logs": {
        "text": "var/infection.log",
        "summary": "var/infection-summary.log"
    },
    "mutators": {
        "@default": true
    },
    // The value reached on 2026-10-20 (ADR-0049): 654 of 677 mutants killed, 96.6 %. The 23 left are
    // equivalent mutants, justified one by one in ADR-0049 — a new survivor lowers the score and fails.
    // Measured with 4 threads, as on a CI runner: on a loaded machine, slow tests time out, and a time out
    // counts as a kill without proving one.
    "minCoveredMsi": 96
}
