parameters:
    level: max
    phpVersion:
        min: 80500
        max: 80599
    paths:
        - bin/devtools
        - src
        - tests
        - rector.php
    excludePaths:
        # Real mini-projects in their own conventions and languages, analysed by DevTools, never by us.
        - tests/Fixtures/projects/*
    treatPhpDocTypesAsCertain: false

    # Level max from day one, and no baseline: a brick extracted with a baseline arrives with its
    # debt already tolerated, and nobody ever picks it up again.
