parameters:
    level: max
    phpVersion:
        min: 80500
        max: 80599
    paths:
        - bin/devtools
        - src
        - tests
        - rector.php
    excludePaths:
        # Real mini-projects in their own conventions and languages, analysed by DevTools, never by us.
        - tests/Fixtures/projects/*
    treatPhpDocTypesAsCertain: false

    # Le niveau max dès le premier jour, et sans baseline : une brique extraite avec une
    # baseline arrive avec sa dette déjà tolérée, et personne ne la reprend ensuite.
