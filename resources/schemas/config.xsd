<?xml version="1.0" encoding="UTF-8"?>
<!--
    The configuration of DevTools for one project: .devtools/config.xml, read by both modes (ADR-0004).

    ⚠️ Public contract: an incompatible change is a new schema-version and a major release.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://github.com/jul6art/devtools/schema/config/1"
           targetNamespace="https://github.com/jul6art/devtools/schema/config/1"
           elementFormDefault="qualified">

    <xs:element name="devtools">
        <xs:complexType>
            <xs:all>
                <xs:element name="paths" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="exclude" type="t:path" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="graph" minOccurs="0">
                    <xs:complexType>
                        <xs:attribute name="depth" type="xs:nonNegativeInteger" use="required"/>
                    </xs:complexType>
                </xs:element>
                <xs:element name="identifiers" minOccurs="0">
                    <xs:complexType>
                        <xs:attribute name="route-prefix" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
                <xs:element name="aliases" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="alias" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="entrypoint" type="t:nonEmpty" use="required"/>
                                    <xs:attribute name="id" type="t:workflowId" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="groups" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="group" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="satellite" type="t:nonEmpty" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                    <xs:attribute name="main" type="t:nonEmpty" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="types" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="type" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="name" type="t:slug" use="required"/>
                                    <xs:attribute name="prefix" type="t:slug" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="symfony" minOccurs="0">
                    <xs:complexType>
                        <xs:attribute name="console" type="t:nonEmpty"/>
                        <xs:attribute name="env" type="t:nonEmpty"/>
                        <xs:attribute name="timeout" type="xs:decimal"/>
                    </xs:complexType>
                </xs:element>
                <xs:element name="routes" minOccurs="0">
                    <xs:complexType>
                        <xs:attribute name="group">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="entry-point"/>
                                    <xs:enumeration value="controller"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="php" minOccurs="0">
                    <xs:complexType>
                        <xs:attribute name="web-root" type="t:nonEmpty"/>
                    </xs:complexType>
                </xs:element>
                <xs:element name="knowledge" minOccurs="0">
                    <xs:complexType>
                        <xs:attribute name="library" type="t:nonEmpty"/>
                        <xs:attribute name="share" type="xs:boolean"/>
                    </xs:complexType>
                </xs:element>
                <!-- How scenarios:run reaches the application (ADR-0021). No credential here: environment variables. -->
                <xs:element name="scenarios" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="login" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="role" type="t:nonEmpty" use="required"/>
                                    <xs:attribute name="type" use="required">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="form"/>
                                                <xs:enumeration value="http-basic"/>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                    <xs:attribute name="username-env" type="t:environmentVariable" use="required"/>
                                    <xs:attribute name="password-env" type="t:environmentVariable" use="required"/>
                                    <xs:attribute name="url" type="t:nonEmpty"/>
                                    <xs:attribute name="username-field" type="t:nonEmpty"/>
                                    <xs:attribute name="password-field" type="t:nonEmpty"/>
                                    <xs:attribute name="submit" type="t:nonEmpty"/>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="fixture" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="name" type="t:nonEmpty" use="required"/>
                                    <xs:attribute name="command" type="t:nonEmpty" use="required"/>
                                </xs:complexType>
                            </xs:element>
                            <!-- How a capture is compared with its baseline (ADR-0022). -->
                            <xs:element name="visual" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <!-- Hidden before every capture: what changes on every run. -->
                                        <xs:element name="mask" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="selector" type="t:nonEmpty" use="required"/>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <!-- The share of the pixels that may differ: 0.1%. -->
                                    <xs:attribute name="threshold">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:pattern value="\d+(\.\d+)?%"/>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="base-url" type="t:nonEmpty"/>
                        <xs:attribute name="timeout" type="xs:positiveInteger"/>
                    </xs:complexType>
                </xs:element>
                <!-- Categories of feedback of the project's own, added to DevTools' ten (ADR-0025). -->
                <xs:element name="feedback" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="category" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="name" use="required">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:pattern value="[a-z][a-z0-9]*(-[a-z0-9]+)*"/>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="language" minOccurs="0">
                    <xs:complexType>
                        <xs:attribute name="pages" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="[a-z]{2}"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:all>
            <xs:attribute name="schema-version" type="xs:positiveInteger" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="nonEmpty">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:pattern value=".*\S.*"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Relative to the project root: neither "/..." nor "C:...". The model refuses ".." on read. -->
    <xs:simpleType name="path">
        <xs:restriction base="xs:string">
            <xs:pattern value="[^/\\]([^:].*)?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="environmentVariable">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Za-z_][A-Za-z0-9_]*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="slug">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z][a-z0-9\-]*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="workflowId">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*(\.[a-z0-9]+(-[a-z0-9]+)*)+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="commit">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{7,64}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="confidence">
        <xs:restriction base="xs:string">
            <xs:enumeration value="high"/>
            <xs:enumeration value="medium"/>
            <xs:enumeration value="low"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="status">
        <xs:restriction base="xs:string">
            <xs:enumeration value="fresh"/>
            <xs:enumeration value="stale"/>
            <xs:enumeration value="orphaned"/>
            <xs:enumeration value="manual"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="mode">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ai"/>
            <xs:enumeration value="no-ai"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="role">
        <xs:restriction base="xs:string">
            <xs:enumeration value="controller"/>
            <xs:enumeration value="service"/>
            <xs:enumeration value="form"/>
            <xs:enumeration value="template"/>
            <xs:enumeration value="entity"/>
            <xs:enumeration value="repository"/>
            <xs:enumeration value="config"/>
            <xs:enumeration value="listener"/>
            <xs:enumeration value="message"/>
            <xs:enumeration value="handler"/>
            <xs:enumeration value="component"/>
            <xs:enumeration value="test"/>
            <xs:enumeration value="other"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="vcs">
        <xs:attribute name="vcs" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="git"/>
                    <xs:enumeration value="none"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="commit" type="t:commit"/>
        <xs:attribute name="branch" type="t:nonEmpty"/>
        <xs:attribute name="dirty" type="xs:boolean"/>
    </xs:complexType>
</xs:schema>
