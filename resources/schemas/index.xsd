<?xml version="1.0" encoding="UTF-8"?>
<!--
    The index of every documented workflow: .devtools/index.xml (specs § 4.4, ADR-0004).

    schema-version 2 adds `docs`: the directory the pages live in, `docs/workflows` by default.

    ⚠️ Public contract: an incompatible change is a new schema-version and a major release.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://github.com/jul6art/devtools/schema/index/1"
           targetNamespace="https://github.com/jul6art/devtools/schema/index/1"
           elementFormDefault="qualified">

    <xs:element name="index">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="source" type="t:vcs"/>
                <xs:element name="workflow" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute name="id" type="t:workflowId" use="required"/>
                        <xs:attribute name="type" type="t:slug" use="required"/>
                        <xs:attribute name="title" type="t:nonEmpty" use="required"/>
                        <xs:attribute name="status" type="t:status" use="required"/>
                        <xs:attribute name="confidence" type="t:confidence" use="required"/>
                        <xs:attribute name="mode" type="t:mode" use="required"/>
                        <xs:attribute name="updated" type="xs:dateTime" use="required"/>
                        <xs:attribute name="page" type="t:path" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="schema-version" type="xs:positiveInteger" use="required"/>
            <xs:attribute name="scanned-at" type="xs:dateTime" use="required"/>
            <!-- Where the pages and the menu were written, relative to the project (ADR-0004). Absent in an
                 index written before schema-version 2: the pages were then inside .devtools/workflows/. -->
            <xs:attribute name="docs" type="t:path"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="nonEmpty">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:pattern value=".*\S.*"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Relative to the project root: neither "/..." nor "C:...". The model refuses ".." on read. -->
    <xs:simpleType name="path">
        <xs:restriction base="xs:string">
            <xs:pattern value="[^/\\]([^:].*)?"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="slug">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z][a-z0-9\-]*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="workflowId">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*(\.[a-z0-9]+(-[a-z0-9]+)*)+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="commit">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{7,64}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="confidence">
        <xs:restriction base="xs:string">
            <xs:enumeration value="high"/>
            <xs:enumeration value="medium"/>
            <xs:enumeration value="low"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="status">
        <xs:restriction base="xs:string">
            <xs:enumeration value="fresh"/>
            <xs:enumeration value="stale"/>
            <xs:enumeration value="orphaned"/>
            <xs:enumeration value="manual"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="mode">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ai"/>
            <xs:enumeration value="no-ai"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="role">
        <xs:restriction base="xs:string">
            <xs:enumeration value="controller"/>
            <xs:enumeration value="service"/>
            <xs:enumeration value="form"/>
            <xs:enumeration value="template"/>
            <xs:enumeration value="entity"/>
            <xs:enumeration value="repository"/>
            <xs:enumeration value="config"/>
            <xs:enumeration value="listener"/>
            <xs:enumeration value="message"/>
            <xs:enumeration value="handler"/>
            <xs:enumeration value="component"/>
            <xs:enumeration value="test"/>
            <xs:enumeration value="other"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="vcs">
        <xs:attribute name="vcs" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="git"/>
                    <xs:enumeration value="none"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="commit" type="t:commit"/>
        <xs:attribute name="branch" type="t:nonEmpty"/>
        <xs:attribute name="dirty" type="xs:boolean"/>
    </xs:complexType>
</xs:schema>
