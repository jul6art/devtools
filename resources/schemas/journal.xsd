<?xml version="1.0" encoding="UTF-8"?>
<!--
    The tasks delivered in a month: .devtools/journal/<YYYY-MM>.xml (ADR-0029), versioned. A task is a piece of work
    the Stop hook let end because the gate passed: when it started, at which commits, the workflows it reached, how
    many passages it took, what failed on the way.

    ⚠️ Public contract: an incompatible change is a new schema-version and a major release.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://github.com/jul6art/devtools/schema/journal/1"
           targetNamespace="https://github.com/jul6art/devtools/schema/journal/1"
           elementFormDefault="qualified">

    <xs:element name="journal">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="task" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="workflow" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="ref" type="t:nonEmpty" use="required"/>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="failed" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="step" type="t:nonEmpty" use="required"/>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="blocked" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="rule" type="t:nonEmpty" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="id" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                        <xs:attribute name="started" type="xs:dateTime" use="required"/>
                        <xs:attribute name="delivered" type="xs:dateTime" use="required"/>
                        <xs:attribute name="base" type="t:commit"/>
                        <xs:attribute name="head" type="t:commit"/>
                        <!-- The passages of the gate it took, the green one included. -->
                        <xs:attribute name="attempts" type="xs:positiveInteger" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="schema-version" type="xs:positiveInteger" use="required"/>
            <xs:attribute name="month" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:pattern value="[0-9]{4}-[0-9]{2}"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
        <xs:unique name="taskId">
            <xs:selector xpath="t:task"/>
            <xs:field xpath="@id"/>
        </xs:unique>
    </xs:element>

    <xs:simpleType name="commit">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{7,64}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="nonEmpty">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:pattern value=".*\S.*"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
