<?xml version="1.0" encoding="UTF-8"?>
<!--
    The index of the shared knowledge library: where each sheet came from, and when (ADR-0041).

    What a listing shows is read here, never by re-reading the sheets themselves.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://github.com/jul6art/devtools/schema/knowledge-library/1"
           targetNamespace="https://github.com/jul6art/devtools/schema/knowledge-library/1"
           elementFormDefault="qualified">

    <xs:element name="knowledge-library">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="entry" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute name="key" type="t:key" use="required"/>
                        <xs:attribute name="project" type="t:nonEmpty" use="required"/>
                        <xs:attribute name="at" type="xs:dateTime" use="required"/>
                        <xs:attribute name="tool" type="t:nonEmpty" use="required"/>
                        <xs:attribute name="sha256" type="t:sha256" use="required"/>
                        <!-- ADR-0044: an amendment of the sheet, from 2 up; absent on the sheet as first deposited. -->
                        <xs:attribute name="revision">
                            <xs:simpleType>
                                <xs:restriction base="xs:positiveInteger">
                                    <xs:minInclusive value="2"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="schema-version" type="xs:positiveInteger" use="required"/>
        </xs:complexType>
        <!-- One line per revision of a key. A schema cannot test an absent attribute, so the original sheet
             (no revision) is held unique by the code, which keys the index by file name. -->
        <xs:unique name="uniqueRevision">
            <xs:selector xpath="t:entry"/>
            <xs:field xpath="@key"/>
            <xs:field xpath="@revision"/>
        </xs:unique>
    </xs:element>

    <xs:simpleType name="nonEmpty">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:pattern value=".*\S.*"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- `symfony-7`, `angular-18`: a stack and its major version, the key of ADR-0005. -->
    <xs:simpleType name="key">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="sha256">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-f]{64}"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
