<?xml version="1.0" encoding="UTF-8"?>
<!--
    What Claude needs to write one workflow page: .devtools/pending/page.<id>.brief.xml (ADR-0002, ADR-0011).

    ⚠️ Public contract: an incompatible change is a new schema-version and a major release.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://github.com/jul6art/devtools/schema/page-brief/1"
           targetNamespace="https://github.com/jul6art/devtools/schema/page-brief/1"
           elementFormDefault="qualified">

    <xs:element name="page-brief">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="prompt">
                    <xs:complexType>
                        <xs:attribute name="version" type="t:nonEmpty" use="required"/>
                        <xs:attribute name="path" type="t:nonEmpty" use="required"/>
                    </xs:complexType>
                </xs:element>
                <xs:element name="language">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[a-z]{2}"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="model" type="t:pathElement"/>
                <xs:element name="page" type="t:pathElement"/>
                <xs:element name="knowledge" type="t:pathElement" minOccurs="0"/>
                <xs:element name="reason" type="t:nonEmpty" minOccurs="0" maxOccurs="unbounded"/>
                <!-- The files of the workflow that moved since the last revision: what to read first. -->
                <xs:element name="change" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute name="path" type="t:nonEmpty" use="required"/>
                        <xs:attribute name="kind" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="added"/>
                                    <xs:enumeration value="removed"/>
                                    <xs:enumeration value="changed"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <!-- The closed list of sections the draft holds, in order: anything else is refused. -->
                <xs:element name="section" type="t:nonEmpty" maxOccurs="unbounded"/>
                <xs:element name="draft" type="t:pathElement"/>
            </xs:sequence>
            <xs:attribute name="schema-version" type="xs:positiveInteger" use="required"/>
            <xs:attribute name="workflow" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*(\.[a-z0-9]+(-[a-z0-9]+)*)+"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="type" type="t:nonEmpty" use="required"/>
            <xs:attribute name="revision" type="xs:dateTime" use="required"/>
            <xs:attribute name="amend" type="xs:boolean" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="pathElement">
        <xs:attribute name="path" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:pattern value="[^/\\]([^:].*)?"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <xs:simpleType name="nonEmpty">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:pattern value=".*\S.*"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
