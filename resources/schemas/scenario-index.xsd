<?xml version="1.0" encoding="UTF-8"?>
<!--
    .devtools/scenarios/index.xml (ADR-0020): who wrote each scenario, the file as it was last recorded, and the
    revision of its workflow it was checked against. A file that no longer matches its hash was modified by
    hand, and is never regenerated; a workflow rewritten after that revision puts its scenarios to review.

    ⚠️ Public contract: an incompatible change is a new schema-version and a major release.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://github.com/jul6art/devtools/schema/scenario-index/1"
           targetNamespace="https://github.com/jul6art/devtools/schema/scenario-index/1"
           elementFormDefault="qualified">

    <xs:element name="scenarios">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="scenario" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute name="id" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*(\.[a-z0-9]+(-[a-z0-9]+)*)+/[a-z0-9]+(-[a-z0-9]+)*"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                        <xs:attribute name="origin" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="skeleton"/>
                                    <xs:enumeration value="claude"/>
                                    <xs:enumeration value="human"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                        <xs:attribute name="sha256" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="[0-9a-f]{64}"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                        <xs:attribute name="revision" type="xs:dateTime" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="schema-version" type="xs:positiveInteger" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
