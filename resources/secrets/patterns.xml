<?xml version="1.0" encoding="UTF-8"?>
<!--
    What `ai:run` never sends to the Claude API (ADR-0035): a brief whose files hold one of these is refused,
    and nothing leaves the machine. Patterns are PCRE, matched on every file the task would send.
-->
<secret-patterns xmlns="https://github.com/jul6art/devtools/schema/secret-patterns/1" schema-version="1">
    <pattern name="AWS access key">AKIA[0-9A-Z]{16}</pattern>
    <pattern name="AWS secret key">aws_secret_access_key\s*[=:]\s*\S{20,}</pattern>
    <pattern name="GitHub token">\bgh[pousr]_[A-Za-z0-9]{36,}</pattern>
    <pattern name="GitHub fine-grained token">\bgithub_pat_[A-Za-z0-9_]{40,}</pattern>
    <pattern name="Anthropic key">\bsk-ant-[A-Za-z0-9_-]{20,}</pattern>
    <pattern name="OpenAI key">\bsk-(?:proj-)?[A-Za-z0-9]{32,}</pattern>
    <pattern name="Slack token">\bxox[abposr]-[A-Za-z0-9-]{10,}</pattern>
    <pattern name="Stripe secret key">\b[sr]k_live_[A-Za-z0-9]{20,}</pattern>
    <pattern name="Google API key">\bAIza[0-9A-Za-z_-]{35}</pattern>
    <pattern name="private key">-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED |PGP )?PRIVATE KEY</pattern>
    <pattern name="password assignment">(?i)\b(?:password|passwd|pwd|secret|api_?key|token)\s*[=:]\s*['"][^'"\s]{8,}['"]</pattern>
    <pattern name="URL with credentials">\b[a-z][a-z0-9+.-]*://[^\s:/@]+:[^\s@/]{3,}@</pattern>
</secret-patterns>
