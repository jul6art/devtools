<?xml version="1.0" encoding="UTF-8"?>
<stacks xmlns="https://github.com/jul6art/devtools/schema/stack/1" schema-version="1">
  <project name="acme/symfony-minimal"/>
  <stack root=".">
    <language>php</language>
    <framework version="8.1">symfony</framework>
    <package-manager>composer</package-manager>
    <adapter>symfony</adapter>
    <knowledge>symfony-8</knowledge>
    <sources>
      <dir>config</dir>
      <dir>migrations</dir>
      <dir>src</dir>
      <dir>templates</dir>
    </sources>
    <tests>
      <dir>tests</dir>
    </tests>
    <excludes>
      <dir>.devtools</dir>
      <dir>.git</dir>
      <dir>build</dir>
      <dir>dist</dir>
      <dir>node_modules</dir>
      <dir>var</dir>
      <dir>vendor</dir>
    </excludes>
  </stack>
</stacks>
