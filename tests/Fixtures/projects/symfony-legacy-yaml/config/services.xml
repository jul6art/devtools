<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <prototype namespace="App\" resource="../src/" exclude="../src/{Entity,ValueObject,Message,Kernel.php}"/>

        <service id="App\Command\ImportCatalogCommand">
            <tag name="console.command" command="app:import-catalog"/>
        </service>

        <service id="App\MessageHandler\OrderCreatedHandler">
            <tag name="messenger.message_handler"/>
        </service>

        <service id="App\EventListener\LocaleListener">
            <tag name="kernel.event_listener" event="kernel.request" priority="20"/>
        </service>
    </services>
</container>
