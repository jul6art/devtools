{
    "name": "acme/symfony-minimal",
    "description": "DevTools fixture: a small Symfony application with one entry point of every kind.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-live-component": "^2.30",
        "symfony/workflow": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
